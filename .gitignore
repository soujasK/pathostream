# Node (web/ has its own, more complete .gitignore; this covers the root TS project)
node_modules/
dist/

# Leftover local venv from before the project was restructured to be Node/TS-only
.venv/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Environment / secrets -- real keys never go in the repo; .env.example is the
# empty template.
.env
.env.*
!.env.example

# Demo videos are large binaries; they are shared by link, not committed.
*.mp4
