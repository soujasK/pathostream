# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Google Gemini key for the multi-agent layer. Leave empty to run the agents
# rule-based only (no language model); the UI and API say so.
GEMINI_API_KEY=

# Optional: Gemini model id (default gemini-2.5-flash). The free tier has a
# small per-model daily quota, so a different model can help for demos.
OAH_GEMINI_MODEL=

# Optional: per-request timeout for the model in ms (default 20000).
OAH_GEMINI_TIMEOUT_MS=

# Optional: set to "on" to allow symptom text to reach the external model.
# Off by default (SAFETY_CASE.md H14.4); even when on, no patient identifier
# or location is ever sent.
OAH_AGENTS_PATIENT_DATA_TO_LLM=
