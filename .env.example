# PathoStream-EHR configuration
# Copy this file to `.env` and fill in real values before running.
# NOTHING in this repository should be pointed at a production EHR,
# a production FHIR store, or real patient data. See README.md.

# --- Gemini clinical synthesis (optional) ---------------------------------
# If unset, empty, or if the Gemini call fails/times out, the service
# ALWAYS falls back to the deterministic rule-based CDS card in
# app/core/gemini_synthesizer.py::deterministic_fallback_card(). No alert
# is ever silently dropped because an API key is missing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=2.5

# --- FHIR sandbox persistence ----------------------------------------------
# Point this at a local HAPI FHIR docker instance or public sandbox, e.g.
# https://hapi.fhir.org/baseR4 . Never point this at a real EHR's FHIR API.
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT_SECONDS=5.0

# --- Catchment Contamination Index (CCI) thresholds -------------------------
CCI_BIOHAZARD_THRESHOLD=25.0
CCI_LOW_DO_MG_L=2.0
CCI_HIGH_COLIFORM_CFU_100ML=1000.0

# --- Downstream contamination-propagation forecasting (resilience/early-warning) --
# Illustrative defaults -- NOT calibrated to real Mithi River hydrology. See
# app/core/propagation_engine.py.
PROPAGATION_FLOW_VELOCITY_M_S=0.3
PROPAGATION_HORIZON_MINUTES=240.0

# --- Service ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
